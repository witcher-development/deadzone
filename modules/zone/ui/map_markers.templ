package zone_ui

import (
	"fmt"
	model "github.com/witcher-development/deadzone/modules/zone/model"
)

templ MapMarkers(zones []model.Zone) {
<div id="map-markers" hx-swap-oob="innerHTML">
	for _, zone := range zones {
	<svg height="20px" width="20px" id={ fmt.Sprintf("marker-%d", zone.Id) } class="map-marker" viewBox="0 0 512 512" hidden>
		<path style="fill:#999999;" d="M87.084,192c-0.456-5.272-0.688-10.6-0.688-16C86.404,78.8,162.34,0,256.004,0s169.6,78.8,169.6,176  c0,5.392-0.232,10.728-0.688,16h0.688c0,96.184-169.6,320-169.6,320s-169.6-223.288-169.6-320H87.084z M256.004,224  c36.392,1.024,66.744-27.608,67.84-64c-1.096-36.392-31.448-65.024-67.84-64c-36.392-1.024-66.744,27.608-67.84,64  C189.26,196.392,219.612,225.024,256.004,224z"/>
	</svg>
	}
</div>
}
